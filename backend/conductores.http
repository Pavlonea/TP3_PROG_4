@host = http://localhost:3000

### Login (guarda el token)
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "secreto123"
}

###
@token = {{login.response.body.token}}

### Listar conductores
GET {{host}}/conductores
Authorization: Bearer {{token}}

### Listar con filtros
GET {{host}}/conductores?apellido=gom
Authorization: Bearer {{token}}

### Detalle
GET {{host}}/conductores/1
Authorization: Bearer {{token}}

### Crear
POST {{host}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Gómez",
  "numero_documento": "30123456",
  "numero_licencia": "LIC-0001",
  "fecha_alta_licencia": "2020-03-15",
  "fecha_vencimiento_licencia": "2027-03-15"
}

### Crear inválido: vencimiento anterior al alta (400)
POST {{host}}/conductores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Gómez",
  "numero_documento": "123",
  "numero_licencia": "LIC-0002",
  "fecha_alta_licencia": "2025-01-01",
  "fecha_vencimiento_licencia": "2020-01-01"
}

### Modificar
PUT {{host}}/conductores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Juan Carlos",
  "apellido": "Gómez",
  "numero_documento": "30123456",
  "numero_licencia": "LIC-0001",
  "fecha_alta_licencia": "2020-03-15",
  "fecha_vencimiento_licencia": "2028-03-15"
}

### Eliminar
DELETE {{host}}/conductores/1
Authorization: Bearer {{token}}
